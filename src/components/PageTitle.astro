---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const route = Astro.locals.starlightRoute;
const data = route?.entry?.data ?? {};

const PRODUCT_LABELS = {
  standard: 'SiteSync Standard',
  'enterprise-management': 'Enterprise Management',
  'field-app': 'Field App',
};
const ROLE_LABELS = {
  administrator: 'Administrator',
  'field-user': 'Field user',
};

const products = (data.products ?? []).map((p) => PRODUCT_LABELS[p] ?? p);
const roles = (data.roles ?? []).map((r) => ROLE_LABELS[r] ?? r);
const introduced = data.introduced;
const showBanner = products.length > 0;
---

<Default />

{
  showBanner && (
    <div class="ss-applies" role="note" aria-label="Product applicability">
      <span class="ss-applies__label">Applies to</span>
      <span class="ss-applies__pills">
        {products.map((p) => (
          <span class="ss-pill">{p}</span>
        ))}
      </span>
      {introduced && <span class="ss-applies__meta">Introduced in {introduced}</span>}
      {roles.length > 0 && <span class="ss-applies__meta">Role: {roles.join(', ')}</span>}
    </div>
  )
}
